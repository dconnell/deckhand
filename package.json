{
  "name": "deckhand",
  "version": "0.1.0",
  "description": "Local presentation coordinator that keeps four outputs in sync: slide position, OBS scenes, presenter-side state on macOS, and Deckhand-owned Chrome windows and tabs.",
  "type": "module",
  "scripts": {
    "obs:setup": "node ./src/setupObs.js",
    "hammerspoon:setup": "node ./src/setupHammerspoon.js",
    "presenter:stt": "node ./src/presenter/stt/cli.js",
    "presenter:smoke": "node ./src/presenterSmoke.js",
    "presenter:doctor": "node ./src/presenterDoctor.js",
    "test": "node --test",
    "test:integration": "node --test test/integration/*.test.js",
    "test:unit": "node --test \"test/unit/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "ws": "^8.21.1"
  },
  "allowScripts": {}
}
